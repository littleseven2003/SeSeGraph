# 宿主机已有 Nginx 时使用本示例：SeSeGraph 监听 127.0.0.1:8080。
# 用法：放入 /etc/nginx/conf.d/sesegraph.conf 后执行 nginx -t && systemctl reload nginx
# 证书可交给 certbot 或面板管理，这里只演示反代与流式转发。

server {
    listen 80;
    server_name gallery.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name gallery.example.com;

    ssl_certificate     /etc/letsencrypt/live/gallery.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/gallery.example.com/privkey.pem;

    # 发帖工作台单次上传的 ZIP 可能较大，按需调整
    client_max_body_size 64m;
    client_body_timeout 300s;

    # 图片网关是流式反代，禁用缓冲，避免大图先落盘再输出
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_http_version 1.1;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
}
