# SeSeGraph systemd 单元模板：直接运行原生单二进制时使用。
# 数据目录由 systemd 的 StateDirectory 创建并授权给运行用户，无需手工建目录或 chown。
# 用法：
#   install -d /opt/sesegraph /etc/sesegraph
#   cp bin/sesegraph /opt/sesegraph/sesegraph
#   cp deploy/sesegraph.service /etc/systemd/system/sesegraph.service
#   install -m 600 .env /etc/sesegraph/sesegraph.env
#   useradd --system --home /opt/sesegraph --shell /usr/sbin/nologin sesegraph
#   systemctl daemon-reload && systemctl enable --now sesegraph
# 数据库与上传临时文件位于 /var/lib/sesegraph，升级时只需替换 /opt/sesegraph/sesegraph。

[Unit]
Description=SeSeGraph 图册服务
Documentation=https://github.com/littleseven2003/SeSeGraph
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sesegraph
Group=sesegraph
WorkingDirectory=/opt/sesegraph
EnvironmentFile=-/etc/sesegraph/sesegraph.env
# 首次启动自动创建 /var/lib/sesegraph 并归属运行用户，重启保留数据。
StateDirectory=sesegraph
StateDirectoryMode=0750
ExecStart=/opt/sesegraph/sesegraph --addr 127.0.0.1:8080 --data /var/lib/sesegraph
Restart=always
RestartSec=3

# 收紧权限：只允许写状态目录，其余文件系统只读
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true

[Install]
WantedBy=multi-user.target
