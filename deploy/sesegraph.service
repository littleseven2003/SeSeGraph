# SeSeGraph systemd 单元模板：直接运行原生单二进制时使用。
# 用法：
#   install -d /opt/sesegraph /etc/sesegraph
#   cp bin/sesegraph /opt/sesegraph/sesegraph
#   cp deploy/sesegraph.service /etc/systemd/system/sesegraph.service
#   install -m 600 .env /etc/sesegraph/sesegraph.env
#   useradd --system --home /opt/sesegraph --shell /usr/sbin/nologin sesegraph
#   chown -R sesegraph:sesegraph /opt/sesegraph
#   systemctl daemon-reload && systemctl enable --now sesegraph

[Unit]
Description=SeSeGraph 图册服务
Documentation=https://github.com/littleseven2003/SeSeGraph
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sesegraph
Group=sesegraph
WorkingDirectory=/opt/sesegraph
EnvironmentFile=-/etc/sesegraph/sesegraph.env
ExecStart=/opt/sesegraph/sesegraph --addr 127.0.0.1:8080 --data /opt/sesegraph/data
Restart=always
RestartSec=3

# 收紧权限：只允许写数据目录，其余文件系统只读
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ReadWritePaths=/opt/sesegraph/data

[Install]
WantedBy=multi-user.target
