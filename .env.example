# SeSeGraph 环境变量示例
# 复制为 .env 后填写实际值；.env 已被忽略，请勿提交真实凭据。

# 运行配置
LISTEN_ADDR=:8080
DATA_DIR=./data
PUBLIC_URL=https://example.com

# 管理员账号（仅首次初始化使用，初始化后以数据库中的哈希为准）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Telegram 图床
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# Telegraph 发布
TELEGRAPH_ACCESS_TOKEN=
TELEGRAPH_AUTHOR_NAME=

# 网络代理：direct（直连）/ system（跟随环境变量）/ custom（自定义）
PROXY_MODE=direct
PROXY_URL=
PROXY_FOR_TELEGRAM=true
PROXY_FOR_TELEGRAPH=true

# 上传与发布
UPLOAD_MODE=photo
UPLOAD_INTERVAL_MIN_MS=1500
UPLOAD_INTERVAL_MAX_MS=3000

# 图片网关
PROXY_CONCURRENCY=25

# 流量看护（单位：GB，0 表示不启用该阈值）
TRAFFIC_ALERT_GB=0
TRAFFIC_LIMIT_GB=0

# 定时备份
BACKUP_ENABLED=false
BACKUP_CRON=0 3 * * *
BACKUP_CHANNEL_ID=

# Docker Compose 部署时由 Caddy 使用
DOMAIN=example.com
