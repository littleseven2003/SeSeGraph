# SeSeGraph 环境变量示例
# 复制为 .env 后填写实际值；.env 已被忽略，请勿提交真实凭据。

# 运行配置
LISTEN_ADDR=:8080
DATA_DIR=./data
PUBLIC_URL=https://example.com
# 站点订阅源：设为 true 且 PUBLIC_URL 为有效 HTTPS 地址时提供 /rss.xml
RSS_ENABLED=false

# 管理员账号（仅首次初始化使用，初始化后以数据库中的哈希为准）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 网页引导初始化凭证（可选；配置后首次初始化需在请求头 X-Setup-Token 携带该值，初始化完成后失效）
ADMIN_SETUP_TOKEN=

# Telegram 图床
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
# 可选：上游地址，接入自建反代或本地联调时使用
TELEGRAM_API_BASE=

# Telegraph 发布：访问令牌可手填，也可由管理接口自动申请后写入数据库
TELEGRAPH_ACCESS_TOKEN=
TELEGRAPH_AUTHOR_NAME=
# 可选：自建反代地址
TELEGRAPH_API_BASE=

# 网络代理：direct（直连）/ system（跟随环境变量）/ custom（自定义）
# 以下几项默认留空，由设置页维护；注释掉即表示交给界面，填写后该字段以环境变量为准并在界面置灰。
# PROXY_MODE=direct
# PROXY_URL=
# 代理开关未设置时按关闭处理，配置代理地址后请在设置页勾选需要走代理的上游。
# PROXY_FOR_TELEGRAM=true
# PROXY_FOR_TELEGRAPH=true

# 上传与发布
# 默认画质留空即用程序默认值 photo（省流量），可在工作台或设置页修改。
# UPLOAD_MODE=photo
UPLOAD_INTERVAL_MS=1500
# 服务端同时接收上传的上限，前端每轮固定两路；此项只影响服务端。
UPLOAD_CONCURRENCY=3
# Telegraph 链接生成方式：title 按标题（默认）/ slug 自动生成无中文链接。留空即由设置页管理。
# TELEGRAPH_PATH_MODE=title

# 浏览量同步：后台默认每 30 分钟一轮，手动刷新冷却 60 秒
VIEWS_SYNC_MINUTES=30
VIEWS_COOLDOWN_SECONDS=60

# 图片网关：取流并发上限；满额后先排队，队列满或等待超时才返回 503（带 Retry-After）
PROXY_CONCURRENCY=25
PROXY_QUEUE_DEPTH=100
PROXY_QUEUE_WAIT=15

# 流量看护（单位：GB，0 表示不启用该阈值）；留空则用程序默认值，可在设置页修改
# TRAFFIC_ALERT_GB=0
# TRAFFIC_LIMIT_GB=0

# 定时备份：BACKUP_INCLUDE_THUMBS=false 可只备份数据库，不含封面缩略图；BACKUP_KEEP 是本地保留份数
# 是否启用、每日时刻与保留份数留空即用程序默认值（关闭、03:00、7 份），可在设置页修改。
# BACKUP_ENABLED=false
# BACKUP_CRON=0 3 * * *
# BACKUP_KEEP=7
# 备份推送目标频道留空时复用图床频道
BACKUP_CHANNEL_ID=
BACKUP_INCLUDE_THUMBS=true

# 逐图缩略图缓存上限（字节）；留空由设置页维护，默认 2 GiB，调小后立即按最近最少使用淘汰
# MEDIA_THUMB_LIMIT_BYTES=2147483648

# Docker Compose 部署：Caddy 使用 DOMAIN 申请证书
DOMAIN=example.com

# Compose 拉取的镜像：默认固定到当前发布版本，避免自动跟随未验证的更新
# 需要跟随后续发布时显式改成 latest；也可用 SESEGRAPH_IMAGE 指定完整镜像地址
SESEGRAPH_VERSION=v1.4.3
SESEGRAPH_IMAGE=
