# 构建上下文裁剪：只保留构建所需源码，避免把本地数据与依赖打进镜像
.git
.gitignore
.github
.cache
.pnpm-store
bin
data
*.db
*.db-shm
*.db-wal
.env
.env.*
!/.env.example
README.md
CHANGELOG.md
LICENSE
frontend/src/dev
# 本地 HTML 样屏只留在工作区，不进入构建上下文
frontend/auth-*.html
frontend/drawer-*.html
frontend/workbench-*.html
# 本地临时素材与个人样屏，不入镜像
.local
.local/
deploy/*.local.conf
frontend/node_modules
docs
frontend/dist
backend/internal/web/assets/static
backend/internal/web/assets/index.html
